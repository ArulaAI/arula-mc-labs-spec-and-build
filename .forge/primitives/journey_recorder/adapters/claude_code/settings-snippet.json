{
  "_comment": "Merge this into .claude/settings.json hooks section via 'forge sync'. Registers journey-recorder hooks for all 5 Claude Code lifecycle events. Deep-merge — do not overwrite existing hooks arrays.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/primitives/journey_recorder/adapters/claude_code/record-hook.sh pre_tool_use \"$CLAUDE_TOOL_NAME\" \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/primitives/journey_recorder/adapters/claude_code/record-hook.sh post_tool_use \"$CLAUDE_TOOL_NAME\" \"$CLAUDE_TOOL_RESULT\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/primitives/journey_recorder/adapters/claude_code/record-hook.sh user_prompt_submit \"\" \"$CLAUDE_USER_PROMPT\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/primitives/journey_recorder/adapters/claude_code/record-hook.sh session_start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .forge/primitives/journey_recorder/adapters/claude_code/record-hook.sh session_end"
          }
        ]
      }
    ]
  }
}
