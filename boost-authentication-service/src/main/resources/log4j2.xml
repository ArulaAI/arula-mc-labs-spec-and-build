<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application logging for the retrieval service.

  The File appender gives the lab a scannable sink: `logs/auth-service.log` is what the
  sensitive-data scan and the no-sensitive-log test read. append="false" so each run starts
  from a clean file and the evidence always describes the run you just did.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT" follow="true">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
    </Console>
    <File name="ServiceLog" fileName="logs/auth-service.log" append="false">
      <PatternLayout pattern="%d{ISO8601} %-5level %logger{36} - %msg%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="com.mastercard.pgs.auth" level="INFO"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="ServiceLog"/>
    </Root>
  </Loggers>
</Configuration>
